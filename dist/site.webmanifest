{
  "name": "structureCo · Análisis estructural 2D",
  "short_name": "structureCo",
  "description": "Modelado, análisis y aprendizaje interactivo de estructuras planas 2D.",
  "lang": "es",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3eee4",
  "theme_color": "#f3eee4",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-structureco": [
          ".structureco"
        ],
        "application/json": [
          ".structureco.json"
        ]
      }
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ]
}
