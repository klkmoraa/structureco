{
  "name": "structureco",
  "private": true,
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=1 --pool=threads --no-file-parallelism",
    "verify:docs": "node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs",
    "verify:protected": "node scripts/check-protected-baseline.mjs",
    "verify:pwa": "node --test scripts/pwa-shell-source.test.mjs",
    "verify:i18n": "node --test scripts/check-i18n-usage.test.mjs && node scripts/check-i18n-usage.mjs",
    "audit:i18n": "node --test scripts/audit-i18n-with-types.test.mjs && node scripts/audit-i18n-with-types.mjs",
    "verify:structural-assets": "node --test scripts/structural-png-contract.test.mjs scripts/structural-asset-bundle.test.mjs && node scripts/check-three-structural-renders.mjs",
    "perf": "npm run build && node scripts/measure-performance.mjs",
    "inspect:pdf": "node scripts/inspect-pdf.mjs",
    "validate:ci": "node scripts/validate-ci.mjs",
    "verify:perf": "node scripts/check-performance-budget.mjs",
    "verify:space3d": "vitest run src/space3d src/features/space3d --maxWorkers=1 --pool=threads --no-file-parallelism && node --test scripts/check-space3d-capacity.test.mjs && node scripts/check-space3d-capacity.mjs",
    "verify": "npm run lint && npm run verify:docs && npm run verify:protected && npm run verify:pwa && npm run verify:i18n && npm run verify:styles && npm test && npm run build && npm run verify:perf",
    "qa": "npm run build && node qa.mjs",
    "qa:captures": "node capturas.mjs",
    "qa:topbar": "npm run build && node scripts/qa-topbar.mjs",
    "qa:model-doctor": "npm run build && node scripts/qa-model-doctor.mjs",
    "qa:model-doctor-peek": "npm run build && node scripts/qa-model-doctor-peek.mjs",
    "qa:datasheet-k0": "npm run build && node scripts/qa-datasheet-k0.mjs",
    "qa:shell-composition": "npm run build && node scripts/qa-shell-composition.mjs",
    "qa:results-cards": "npm run build && node scripts/qa-results-cards.mjs",
    "assets:generate": "node scripts/generate-three-portal-assets.mjs",
    "qa:home": "npm run build && node scripts/qa-total-home-redesign.mjs",
    "qa:structural-assets": "npm run build && node scripts/qa-structural-assets.mjs",
    "qa:illustration-studio": "npm run build && node scripts/qa-illustration-studio.mjs",
    "qa:illustration-studio:webkit": "npm run build && node scripts/qa-illustration-studio.mjs --webkit",
    "qa:bulk-edit": "npm run build && node scripts/qa-bulk-edit.mjs",
    "qa:personal-library": "npm run build && node scripts/qa-personal-library.mjs",
    "qa:structural-bom": "npm run build && node scripts/qa-structural-bom.mjs",
    "qa:revision-comparison": "npm run build && node scripts/qa-revision-comparison.mjs",
    "qa:bulk-edit:webkit": "npm run build && node scripts/qa-bulk-edit.mjs --webkit",
    "qa:structural-edits": "npm run build && node scripts/qa-structural-edits.mjs",
    "qa:structural-edits:webkit": "npm run build && node scripts/qa-structural-edits.mjs --webkit",
    "qa:structure-generator": "npm run build && node scripts/qa-structure-generator.mjs",
    "qa:structure-generator:webkit": "npm run build && node scripts/qa-structure-generator.mjs --webkit",
    "qa:webkit": "npm run build && node qa-webkit.mjs",
    "verify:styles": "node --test scripts/check-global-css.test.mjs && node scripts/check-global-css.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^1.24.0",
    "motion": "^12.43.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
